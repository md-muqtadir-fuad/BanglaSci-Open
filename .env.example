# Google AI Studio key for Gemma 4 (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Optional overrides. AI Studio limits for each Gemma 4 model (checked 2026-10-30):
# 30 RPM, 16K TPM, 14.4K RPD. Defaults match these.
# Scripts stay GEMMA_MARGIN below every limit (0.2 = use 80%).
GEMMA_MODEL=gemma-4-31b-it
GEMMA_RPM=30
GEMMA_TPM=16000
GEMMA_RPD=14400
GEMMA_MARGIN=0.2
GEMMA_WORKERS=16
